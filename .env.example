# Auth.js (NextAuth v5) — JWT sessions, no database adapter
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional on Vercel (trustHost is enabled in code). Set locally if needed:
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Upstash Redis (required on Vercel multi-instance; memory fallback locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
