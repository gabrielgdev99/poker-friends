# Auth.js (NextAuth v5) — JWT sessions, no database adapter
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional on Vercel (trustHost is enabled in code). Set locally if needed:
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Upstash Redis — REQUIRED on Vercel (memory fallback only for local `npm run dev`)
# Also accepted: KV_REST_API_URL / KV_REST_API_TOKEN (Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Admin allowlist (optional). Comma-separated emails.
# If unset, defaults to goncalvesvg1999@gmail.com
# ADMIN_EMAILS=goncalvesvg1999@gmail.com,outro@example.com

# Default decision timer seconds for new rooms (8–60). Host can change per room.
# TURN_SECONDS=18

